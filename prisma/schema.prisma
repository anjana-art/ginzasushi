// prisma/schema.prisma
// Ginza — Japanese Sushi Takeaway

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER ====================
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  password    String
  phone       String?
  isAdmin     Boolean   @default(false)
  isBlocked   Boolean   @default(false)
  blockedAt   DateTime?
  blockReason String?
  points            Int @default(0)
  totalOrders       Int @default(0)

  // Password reset
  resetToken    String?   @unique
  resetTokenExp DateTime?

  // Relationships
  addresses   Address[]
  userProfile UserProfile?
  ratings     Rating[]
  orders      Order[]
  cart        Cart?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ==================== USER PROFILE ====================
model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName    String?
  lastName     String?
  displayName  String?
  phoneNumber  String?
  dateOfBirth  DateTime?
  profileImage String?

  country      String?
  city         String?
  postalCode   String?
  addressLine1 String?

  // Preferences
  newsletter  Boolean @default(true)
  smsAlerts   Boolean @default(false)
  emailAlerts Boolean @default(true)

  // Sushi preferences
  favouriteRoll  String?
  spiceTolerance SpiceLevel @default(MILD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

// ==================== ADDRESS ====================
model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AddressType @default(DELIVERY)
  isDefault Boolean     @default(false)

  fullName String
  phone    String?
  email    String?

  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  country      String  @default("United Kingdom")
  postalCode   String

  // Delivery specifics
  instructions  String? // e.g. "Ring bell, leave at door"
  deliveryNotes String? // e.g. "Flat 3B, second floor"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

enum AddressType {
  DELIVERY
  BILLING
  HOME
  WORK
  OTHER
}

// ==================== CATEGORY ====================
model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  image       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// ==================== MENU ITEM ====================
model MenuItem {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  images      String[] @default([])

  // Classification
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Sushi-specific
  spiceLevel        SpiceLevel @default(NONE)
  isVegetarian      Boolean    @default(false)
  isVegan           Boolean    @default(false)
  isGlutenFree      Boolean    @default(false)
  isContainsRawFish Boolean    @default(false)

  // Allergens as array: ["fish", "shellfish", "soy", "gluten", "sesame"]
  allergens String[] @default([])

  // Info
  prepTime Int? // minutes
  calories Int?
  serves   Int? // e.g. 1, 2

  // Availability
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  stock      Int     @default(0)

  // Relationships
  options    MenuItemOption[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  ratings    Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@map("menu_items")
}

// ==================== MENU ITEM OPTION ====================
// e.g. "Extra Wasabi" +£0.50, "Large Portion" +£2.00, "Spicy Mayo" +£0.75
model MenuItemOption {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  name            String
  group           String  @default("Extras") // e.g. "Size", "Extras", "Spice"
  priceAdjustment Decimal @default(0) @db.Decimal(10, 2)
  isDefault       Boolean @default(false)
  isRequired      Boolean @default(false)
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuItemId])
  @@map("menu_item_options")
}

// ==================== CART ====================
model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  optionId String?
  option   MenuItemOption? @relation(fields: [optionId], references: [id])

  // Denormalized snapshot
  name     String
  price    Decimal @db.Decimal(10, 2)
  quantity Int     @default(1)
  image    String?
  notes    String? // special instructions from customer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@map("cart_items")
}

// ==================== ORDER ====================
model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderNumber String @unique @default(uuid())

  // Pricing
  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  tax         Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  // Fulfillment
  deliveryType DeliveryType @default(PICKUP)
  pickupTime   DateTime?
  deliveryTime DateTime?

  // Addresses (JSON snapshot)
  deliveryAddress Json? @db.JsonB
  billingAddress  Json? @db.JsonB

  // Customer info
  customerName        String
  customerPhone       String
  customerEmail       String
  specialInstructions String?

  // Invoice (Portuguese style kept for compatibility)
  invoiceId     String?
  invoiceNumber String?
  invoiceUrl    String?
  invoicePdf    String?

  // Status
  status         OrderStatus     @default(PENDING)
  trackingStatus TrackingStatus?

  // Payment (Stripe)
  paymentMethod         String? @default("card")
  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique
  stripeCustomerId      String?

  // Items
  items OrderItem[]

  // Timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  paidAt           DateTime?
  confirmedAt      DateTime?
  preparingAt      DateTime?
  readyAt          DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  optionId String?
  option   MenuItemOption? @relation(fields: [optionId], references: [id])

  // Snapshot at time of purchase
  name     String
  price    Decimal @db.Decimal(10, 2)
  quantity Int     @default(1)
  image    String?
  notes    String?

  @@index([orderId])
  @@map("order_items")
}

// ==================== RATING / REVIEWS ====================
model Rating {
  id         String @id @default(cuid())
  menuItemId String
  userId     String

  rating Int      @default(5)
  review String?
  images String[] @default([])

  helpfulVotes     Int          @default(0)
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([menuItemId, userId])
  @@index([menuItemId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("ratings")
}

// ==================== ENUMS ====================
enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  EXTRA_HOT
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TrackingStatus {
  ORDER_RECEIVED
  ORDER_PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REPORTED
}

// ==================== SECURITY ====================
model BlockedAttempt {
  id          String   @id @default(cuid())
  email       String
  ip          String
  reason      String
  attemptedAt DateTime @default(now())

  @@map("blocked_attempts")
}
